<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.BMIController"
      spacing="12.0"
      prefWidth="480.0"
      prefHeight="620.0"
      style="-fx-background-color: #f8fafc;
             -fx-font-family: 'SansSerif';
             -fx-font-size: 14px;">

    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

    <children>

        <Label text="Kalkulator BMI"
               style="-fx-font-size: 26px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #0f172a;"/>

        <Label text="Hitung indeks massa tubuh Anda dengan mudah."
               wrapText="true"
               style="-fx-text-fill: #64748b;"/>

        <Label text="Pilih Gender"/>

        <ComboBox fx:id="genderBox"
                  maxWidth="Infinity"/>

        <Label text="Berat Badan (kg)"/>

        <TextField fx:id="beratField"
                   promptText="Contoh: 50"/>

        <Label text="Tinggi Badan (cm)"/>

        <TextField fx:id="tinggiField"
                   promptText="Contoh: 160"/>

        <Button text="Hitung BMI"
                onAction="#hitung"
                defaultButton="true"
                maxWidth="Infinity"
                style="-fx-background-color: #2563eb;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 12;
                       -fx-background-radius: 8;"/>

        <Button text="Reset"
                onAction="#reset"
                maxWidth="Infinity"
                style="-fx-background-color: #e2e8f0;
                       -fx-text-fill: #0f172a;
                       -fx-padding: 12;
                       -fx-background-radius: 8;"/>

        <Label fx:id="hasilLabel"
               text="Hasil perhitungan akan tampil di sini."
               wrapText="true"
               minHeight="140.0"
               style="-fx-text-fill: #64748b;"/>

    </children>

</VBox>